#!/usr/bin/env bash

set -eux

source "${SNAP}/opt/opensearch-dashboards/helpers/io.sh"

# Runs on install, refresh and `snap set`, so it also repairs the ownership of
# the Wazuh data tree created by an older revision.
prepare_wazuh_data_dirs

scheme=$(snapctl get scheme)
if [ -z "${scheme}" ] || [ "${scheme}" != "https" ]; then
    scheme="http"
fi
snapctl set scheme="${scheme}"
