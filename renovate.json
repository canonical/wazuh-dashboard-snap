{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "enabledManagers": ["custom.regex"],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Wazuh dashboard version and apt package pin in snapcraft.yaml",
      "managerFilePatterns": ["/(^|/)snapcraft\\.yaml$/"],
      "matchStrings": [
        "# renovate: depName=(?<depName>\\S+)\\n[^\\n]*?(?<currentValue>\\d+\\.\\d+\\.\\d+)"
      ],
      "datasourceTemplate": "github-tags",
      "extractVersionTemplate": "^v(?<version>.+)$",
      "versioningTemplate": "semver"
    }
  ],
  "packageRules": [
    {
      "description": "Only follow the supported Wazuh 4.14 patch releases, and keep version and apt pins in one PR.",
      "matchPackageNames": ["wazuh/wazuh-dashboard"],
      "allowedVersions": "/^4\\.14\\./",
      "groupName": "wazuh-dashboard",
      "automerge": false
    }
  ],
  "schedule": ["* * * * 0,6"],
  "vulnerabilityAlerts": {
    "enabled": true
  }
}
